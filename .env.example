# Copy to .env and fill in values. Bun loads .env automatically.
# All ALERT_* variables override config/alert.yaml (env takes precedence).

# App (optional overrides)
# ALERT_DOMAIN=https://alerting.app
# ALERT_APP_NAME=Alert
# ALERT_DB_PATH=data/alert.db

# SMTP
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=noreply@alerting.app
# ALERT_SMTP_PASSWORD=your-smtp-password
# ALERT_SMTP_FROM=Alert <noreply@alerting.app>

# Firebase / FCM — required for push notifications (values in .env; secrets in JSON files)
# ALERT_FIREBASE_PROJECT_ID=your-project-id
# ALERT_FIREBASE_MESSAGING_SENDER_ID=123456789
# ALERT_FIREBASE_API_KEY=AIza...
# ALERT_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# ALERT_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# ALERT_FIREBASE_APP_ID=1:123456789:web:abc...
# Paths to JSON files (do not put key/credential contents in .env):
# ALERT_FIREBASE_VAPID_KEYPAIR_PATH=./secrets/firebase_client-keypair.json
# ALERT_FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
