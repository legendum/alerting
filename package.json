{
  "name": "alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "bun build src/web/main.tsx --outdir=public/dist --target=browser",
    "build:style": "bun run scripts/build-style.ts",
    "build:sw": "bun run scripts/build-sw.ts",
    "build": "rm -rf public/dist && bun run build:web && bun run build:sw",
    "tsc": "tsc -p tsconfig.typecheck.json",
    "start": "bun run build && NODE_ENV=production bun run src/api/server.ts",
    "dev": "bun run build && NODE_ENV=development bun --hot src/api/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test ./tests/billing.test.ts && bun test ./tests/handlers.test.ts ./tests/pues-setup.test.ts ./tests/pues-pwa-sse.test.ts ./tests/webhooks-position-migration.test.ts ./tests/alert-event-filter.test.ts ./tests/webhook-pill.test.ts",
    "smoke": "bun run lint && bun run test && bun run tsc && bun run build",
    "pues": "bun run scripts/pues.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "juice": "^11.1.1",
    "marked": "^17.0.2",
    "nodemailer": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "workbox-build": "^7.4.1"
  }
}
