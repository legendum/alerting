{
  "name": "alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "bun build src/web/main.tsx --outdir=dist --target=browser",
    "start": "bun run build:web && NODE_ENV=production bun run src/api/server.ts",
    "dev": "bun run build:web && NODE_ENV=development bun --hot src/api/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "juice": "^11.1.1",
    "marked": "^17.0.2",
    "nodemailer": "^8.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/nodemailer": "^7.0.9"
  }
}
